# -----------------------------------------
# HealthPredict Pro – Backend Env Template
# Copy this to `.env` and fill your values.
# -----------------------------------------

# Google Cloud Project
GCP_PROJECT_ID=healthpredict-pro-ml
GCP_LOCATION=us-central1

# Vertex AI Endpoint
VERTEX_ENDPOINT_ID=your-endpoint-id

# FastAPI App Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=info

# CORS Allowed Origins (frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://jumuiyatours.com

# Optional: Local development flag
ENVIRONMENT=development
